MONGODB_URL=mongodb://localhost:27017
DB_NAME=foundit
JWT_SECRET=super_secret_foundit_jwt_key_change_in_prod_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# REQUIRED for image upload functionality (Do not use demo/placeholder credentials in production)
CLOUDINARY_CLOUD_NAME=REQUIRED_YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=REQUIRED_YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=REQUIRED_YOUR_CLOUDINARY_API_SECRET

# Vector Search Strategy: 'local' (In-memory Python cosine similarity) or 'atlas' (MongoDB Atlas $vectorSearch)
VECTOR_SEARCH_BACKEND=local

# Gmail SMTP Email Notifications (Use a 16-character Gmail App Password, NOT your regular password)
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_FROM_NAME=FoundIt AI Platform
FRONTEND_URL=http://localhost:3000
